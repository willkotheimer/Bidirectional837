# .NET build output
bin/
obj/
*.user
TestResults/

# Local ephemeral data produced by the seed loader
data/

# Large authoritative datasets fetched by scripts/fetch_and_convert.py
seed/full/

# Python
__pycache__/
*.pyc
.venv/
venv/

# PROVENANCE: ADR-020 - the raw console output of each test run is written here and is not
# versioned. docs/TDD-EVIDENCE.md carries its summary, and the git history carries the RED/GREEN
# commit pair independently.
docs/tdd-evidence/

# Node / Vite client (src/Translator.UI)
node_modules/
dist/
*.tsbuildinfo

# Playwright run artifacts from the portfolio screenshot capture. The capture spec is source and is
# tracked; its output is not - the screenshots themselves are committed in the portfolio repo, where
# they are actually served from.
src/Translator.UI/test-results/
src/Translator.UI/playwright-report/
