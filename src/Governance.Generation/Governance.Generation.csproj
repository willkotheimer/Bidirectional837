<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Governance.Domain\Governance.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- PROVENANCE: ADR-013 - the seed corpus is embedded rather than copied beside the binary, so a
       deployed instance carries its reference data with it and cannot start with an empty catalog. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\seed\hcpcs_categories.csv" LogicalName="Governance.Generation.Seed.hcpcs_categories.csv" />
    <EmbeddedResource Include="..\..\seed\charges_sample.csv" LogicalName="Governance.Generation.Seed.charges_sample.csv" />
  </ItemGroup>

</Project>
